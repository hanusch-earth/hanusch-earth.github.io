---
// One stroke icon set, 1.3px at 12px / 1.4px at 18px.
interface Props { name: 'ext' | 'arrow' | 'close' | 'expand' | 'text' | 'audio' | 'video'; class?: string; label?: string }
const { name, class: cls, label } = Astro.props;
const a11y: Record<string, string> = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
{name === 'ext' && (
  <svg class={cls} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" {...a11y}><path d="M2.5 9.5l7-7M4 2.5h5.5V8" /></svg>
)}
{name === 'arrow' && (
  <svg class={cls} viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" {...a11y}><path d="M1.5 7h11M8.5 3l4 4-4 4" /></svg>
)}
{name === 'close' && (
  <svg class={cls} width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" {...a11y}><path d="M3.5 3.5l11 11M14.5 3.5l-11 11" /></svg>
)}
{name === 'expand' && (
  <svg class={cls} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" {...a11y}><path d="M9.5 2.5h4v4M6.5 13.5h-4v-4M13.5 2.5 9 7M2.5 13.5 7 9" /></svg>
)}
{name === 'text' && (
  <svg class={cls} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" {...a11y}><path d="M3 4.5h12M3 9h12M3 13.5h7.5" /></svg>
)}
{name === 'audio' && (
  <svg class={cls} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" {...a11y}><path d="M2.5 7.5v3M5.75 5v8M9 2.5v13M12.25 5.5v7M15.5 7.5v3" /></svg>
)}
{name === 'video' && (
  <svg class={cls} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" {...a11y}><rect x="1.75" y="3.25" width="14.5" height="11.5" rx="1.5" /><path d="M7.5 6.6v4.8L11.6 9z" /></svg>
)}
