---
// Minimal audio player: play/pause, seek line, time. Nothing loads until play
// (preload="none"); behaviour lives in scripts/site.ts ([data-player]).
interface Props { src: string; title: string; duration?: number }
const { src, title, duration } = Astro.props;
const fmt = (s: number) => {
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = Math.floor(s % 60);
  return (h ? `${h}:${String(m).padStart(2, '0')}` : `${m}`) + `:${String(sec).padStart(2, '0')}`;
};
---
<div class="player" data-player data-duration={duration}>
  <audio preload="none" src={src}></audio>
  <button type="button" class="pp" aria-label={`Play: ${title}`} data-label={title}>
    <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor" /></svg>
    <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.4v10H4.5zM9.1 3h2.4v10H9.1z" fill="currentColor" /></svg>
  </button>
  <input class="seek" type="range" min="0" max={duration ?? 100} step="1" value="0" aria-label={`Position in ${title}`} />
  <span class="time"><span class="cur">0:00</span> / <span class="dur">{duration ? fmt(duration) : '–'}</span></span>
  <p class="perr" role="status" hidden>The recording could not be played here. <a href={src}>Open the audio file</a></p>
</div>
