# hanusch.earth – server settings

# Own page for addresses that do not exist
ErrorDocument 404 /404.html

# Page of the old website that no longer exists
RedirectMatch 301 ^/beekeeping/?$ /

# Correct file type for the fonts
AddType font/woff2 .woff2

# Let browsers keep images and fonts for a while
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
